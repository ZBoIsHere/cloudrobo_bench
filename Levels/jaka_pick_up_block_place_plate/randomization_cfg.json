{
    "metadata": {
        "name": "pick_up_block_and_place_on_plate",
        "description": "a task scene where the robot needs to pick up the block on the desk and place it on the plate",
    },
    "specs": {
        "pose_randomization": {
            "enable": true,
            "specs":[
                {
                    "element_names": ["block"],
                    "enable_translate": true,
                    "enable_rotate": true,
                    "randomization_range": {
                        "translate": {
                            "x": [-0.1, 0.1],
                            "y": [-0.1, 0.1],
                            "z": [0, 0]
                        },
                        "rotate": {
                            "x": [0, 0],
                            "y": [0, 0],
                            "z": [0, 0]
                        }
                    }
                },
                {
                    "element_names": ["jaka"],
                    "enable_translate": true,
                    "enable_rotate": true,
                    "randomization_range": {
                        "translate": {
                            "x": [-0.1, 0.1],
                            "y": [-0.1, 0.1],
                            "z": [0, 0]
                        },
                        "rotate": {
                            "x": [0, 0],
                            "y": [0, 0],
                            "z": [0, 0]
                        }
                    }
                }
            ]
        },
        "material_randomazation": {
            "enable": true,
            "specs":[
            {
                "element_names": ["block"],
                "randomization_range": {
                    "materials": [
                        "block_material_1",
                        "block_material_2",
                        "block_material_3"
                    ],
                    "defiled_materials": [
                        "block_defiled_material_1",
                        "block_defiled_material_2",
                        "block_defiled_material_3"
                    ]
                }
            }
        ]},
        "light_randomization": {
            "enable": true,
            "indoor_light_randomization": {
                "enable": true,
                "specs":[
                    {
                        "element_names": ["light_1"],
                        "enable_switch": true,
                        "enable_intensity": true,
                        "enable_color": true,
                        "randomization_range": {
                            "intensity": [0.5, 1.5],
                            "color": {
                                "r": [0.8, 1.0],
                                "g": [0.8, 1.0],
                                "b": [0.8, 1.0]
                            }
                        }
                    }
                ]
            },
            "nature_light_randomization": {
                "enable": false
            }
        }
    }
}

// 最主要的改动，把surface去掉，随机范围是以物体为中心的一个立方体
// 每个random都添加了enable作为控制点
// 