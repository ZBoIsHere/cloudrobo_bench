                            "y": [0, 0],
                            "z": [0, 0]
                        }
                    }
                },
                {
                    "element_names": ["qinglong"],
                    "enable_translate": true,
                    "enable_rotate": true,
                    "randomization_range": {
                        "translate": {
                            "x": [0, 0],
                            "y": [0, 0],
                            "z": [0, 0]
                        },
                        "rotate": {
                            "x": [0, 0],
                            "y": [0, 0],
                            "z": [0, 0]
                        }
                    }
                }
            ]
        },
        "material_randomazation": {
