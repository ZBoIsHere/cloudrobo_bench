                            "intensity": [0.5, 1.5],
                            "color": {
                                "r": [0.8, 1.0],
                                "g": [0.8, 1.0],
                                "b": [0.8, 1.0]
                            }
                        }
                    }
                ]
            },
            "nature_light_randomization": {
                "enable": false
            }
